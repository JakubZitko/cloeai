# Node Environment
NODE_ENV=development
PORT=3000
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloe_video
# OR individual settings:
# DB_NAME=cloe_video
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
# OR individual settings:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Session
SESSION_SECRET=change-this-to-a-random-secret-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In
APPLE_CLIENT_ID=com.yourcompany.cloe
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY_PATH=./AuthKey_Apple.p8

# OpenAI (for video analysis)
OPENAI_API_KEY=sk-your-openai-api-key

# YouTube API (for reference videos)
YOUTUBE_API_KEY=your-youtube-api-key

# Pexels API (for stock footage)
PEXELS_API_KEY=your-pexels-api-key
